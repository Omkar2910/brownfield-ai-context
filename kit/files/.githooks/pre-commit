#!/bin/sh
# Refuses a commit when a context line in it points at a file that will not exist in the commit.
# Installed by the AI context kit. Skip once in an emergency with: git commit --no-verify
root="$(git rev-parse --show-toplevel)"
tool="$root/.github/hooks/scripts/context-tools.cjs"
[ -f "$tool" ] || tool="$root/.claude/hooks/context-tools.cjs"
[ -f "$tool" ] || exit 0
command -v node >/dev/null 2>&1 || exit 0
node "$tool" check --staged --repo "$root" || {
  echo ""
  echo "Commit stopped: fix the ERROR lines above (update or remove the context line), then commit again."
  exit 1
}
